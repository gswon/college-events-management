# 복사해서 .env 로 저장한 뒤 값 채우기 (.env 는 git에 올리지 말 것)
# 로컬 docker-compose MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nyu_calendar
DB_USER=nyu_ingest
DB_PASSWORD=change-me

# Railway 에서는 위 대신 MYSQL_URL=${{MySQL.MYSQL_URL}} 을 서비스 변수로 넣는다.
# 로컬에서 Railway DB 에 붙을 때는 DATABASE_URL 에 MYSQL_PUBLIC_URL 값을 넣는다.
# DATABASE_URL=mysql://root:password@host:port/railway

# 선택
INGEST_SOURCES=nyu_events,wasserman,athletics
INGEST_APPLY_SCHEMA=all
INGEST_REQUEST_DELAY=1.0
NYU_EVENTS_DAYS_AHEAD=60
NYU_EVENTS_CHUNK_DAYS=1
WASSERMAN_MAX_PAGES=15
